---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { icons } from '../lib/icons.ts';
import { fullSizeImage } from '../lib/images/archive-images.ts';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  credit?: string;
  source?: { label: string; url: string };
  kind?: 'photo' | 'document';
  widths: number[];
  sizes: string;
  eager?: boolean;
  quality?: number;
  class?: string;
}

const { image, alt, caption, credit, source, kind = 'photo', widths, sizes, eager = false, quality } = Astro.props;
const full = await fullSizeImage(image);
// A stable name for statistics: the source file's name without the build hash or extension.
const imageName = image.src.split('?')[0].split('/').pop()!.split('.')[0];
---

<figure class:list={['evidence', `evidence--${kind}`, Astro.props.class]}>
  <a
    class="evidence__link"
    href={full.src}
    data-pswp-width={full.width}
    data-pswp-height={full.height}
    aria-label={`${alt} – nagyítás`}
    data-stat-image={imageName}
  >
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={widths}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      quality={quality}
    />
    <span class="evidence__zoom" set:html={icons.zoomIn} />
  </a>
  <figcaption>
    {caption}
    {
      (credit || source) && (
        <span class="evidence__credit">
          {credit}
          {credit && source && ' · '}
          {source && (
            <a href={source.url} rel="noopener noreferrer">
              {source.label}
            </a>
          )}
        </span>
      )
    }
  </figcaption>
</figure>
