---
interface Props {
  analytics?: boolean;
}

const { analytics = false } = Astro.props;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__title">Dembinszky utca 18.</p>
      <p>Helytörténeti idővonal, 1873–1968</p>
    </div>
    <nav aria-label="Lábléc">
      <ul>
        <li><a href="/epitok/">Építők</a></li>
        <li><a href="/lakok/">Lakók</a></li>
        <li><a href="/nevado/">Névadó</a></li>
        <li><a href="/impresszum/">Impresszum</a></li>
        {
          analytics && (
            <li>
              <button type="button" class="footer-link" data-consent-settings hidden>
                Statisztika beállításai
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</footer>
