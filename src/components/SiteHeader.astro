---
import type { Era } from '../lib/site-data.ts';

interface Props {
  eras: Era[];
  currentPath: string;
}

const { eras, currentPath } = Astro.props;
const pages = [
  { href: '/epitok/', label: 'Építők' },
  { href: '/nevado/', label: 'Névadó' },
  { href: '/impresszum/', label: 'Impresszum' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="Dembinszky utca 18. – kezdőlap">
      <span class="brand__mark">D18</span>
      <span class="brand__name">Dembinszky utca 18.</span>
    </a>
    <nav aria-label="Fő navigáció">
      <button class="menu-button" type="button" popovertarget="fomenu">Menü</button>
      <div class="site-menu" id="fomenu" popover>
        <p class="site-menu__heading" id="menu-korszakok">Korszakok</p>
        <ul class="site-nav" aria-labelledby="menu-korszakok">
          {
            eras.map((era) => (
              <li>
                <a href={`/#korszak-${era.id}`} aria-label={`${era.id.replace('-', '–')}: ${era.title}`}>
                  {era.id.replace('-', '–')}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="site-menu__heading" id="menu-oldalak">Oldalak</p>
        <ul class="site-nav site-nav--pages" aria-labelledby="menu-oldalak">
          {
            pages.map((page) => (
              <li>
                <a href={page.href} aria-current={currentPath === page.href ? 'page' : undefined}>
                  {page.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</header>
