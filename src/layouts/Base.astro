---
import displayFont from '../fonts/cormorant-garamond-latin-500-normal.woff2?url';
import textFont from '../fonts/source-sans-3-latin-400-normal.woff2?url';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { loadSiteData } from '../lib/site-data.ts';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/timeline.css';

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { title, description, path, jsonLd, ogType, noindex } = Astro.props;
const { isDraft, missingItems, eras, analytics } = loadSiteData();
---

<!doctype html>
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin />
    <SeoHead title={title} description={description} path={path} isDraft={isDraft} jsonLd={jsonLd} ogType={ogType} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#tartalom">Ugrás a tartalomra</a>
    {
      isDraft && (
        <p class="draft-banner" role="note">
          Piszkozat – nem publikus előnézet.
          {missingItems.length > 0 && ` Hiányzó szerkesztői adatok: ${missingItems.length}.`}
        </p>
      )
    }
    <SiteHeader eras={eras} currentPath={path} />
    <main id="tartalom">
      <slot />
    </main>
    <SiteFooter analytics={analytics.enabled} />
    {
      analytics.enabled && (
        <section
          class="consent"
          id="statisztika"
          aria-labelledby="statisztika-cim"
          hidden
          data-measurement-id={analytics.measurementId}
          data-site-host={analytics.siteHost}
        >
          <div class="container consent__inner">
            <h2 class="consent__title" id="statisztika-cim" tabindex="-1">Látogatottsági statisztika</h2>
            <p>
              Szeretnénk a Google Analytics segítségével megszámolni, hányan és mit olvasnak az oldalon. Ehhez sütiket
              használunk, de csak akkor, ha hozzájárul. Ha hozzájárul, azt is megjegyezzük a böngészőjében, milyen
              messzire állította az idővonal csúszkáját. <a href="/impresszum/#adatkezeles">Részletek</a>
            </p>
            <p class="consent__status" data-consent-status></p>
            <div class="consent__actions">
              <button type="button" class="consent__button" data-consent="granted">Elfogadom</button>
              <button type="button" class="consent__button" data-consent="denied">Nem kérem</button>
            </div>
          </div>
        </section>
      )
    }
    <script>
      import '../scripts/site-menu.ts';
    </script>
    {
      analytics.enabled && (
        <script>
          import '../scripts/statistics.ts';
        </script>
      )
    }
  </body>
</html>
