---
import facade from '../../../assets/facade6.png';
import EvidenceFigure from '../../components/EvidenceFigure.astro';
import Base from '../../layouts/Base.astro';
import { fullSizeImage } from '../../lib/images/archive-images.ts';
import { figureProps, lakokFigures } from '../../lib/lakok/figures.ts';
import { articleNode, breadcrumbNode, imageNode, websiteNode } from '../../lib/seo/jsonld.ts';
import { loadSiteData } from '../../lib/site-data.ts';
import '../../styles/story.css';

const { site } = loadSiteData();
const siteUrl = Astro.site!;
const path = '/lakok/';
const title = 'Lakók – Dembinszky utca 18.';
const description =
  'Zongoratanárnő, színésznő, vasúti művezető, darukezelő: a Dembinszky utca 18. lakói és foglalkozásaik 1902 és 1954 között.';
const facadeCaption = 'A Dembinszky utca 18. kapuja és földszinti ablakai 2022-ben';
const facadeCredit = 'Fotó: Globetrotter19, 2022, CC BY-SA 3.0, kivágás, utómunka';
const facadeSource = {
  label: 'Wikimedia Commons',
  url: 'https://commons.wikimedia.org/wiki/File:Dembinszky_Stra%C3%9Fe_18_und_20,_2022_Erzs%C3%A9betv%C3%A1ros.jpg',
};
const openingImage = await fullSizeImage(facade);
const jsonLd = [
  websiteNode(siteUrl, site),
  breadcrumbNode(siteUrl, [
    { name: site.building.name, path: '/' },
    { name: 'Lakók', path },
  ]),
  articleNode(siteUrl, { headline: 'Lakók', description, path, imageUrl: new URL(openingImage.src, siteUrl).href }),
  imageNode(siteUrl, {
    contentUrl: openingImage.src,
    caption: facadeCaption,
    credit: facadeCredit,
    sourceUrl: facadeSource.url,
    path,
  }),
];
---

<Base title={title} description={description} path={path} jsonLd={jsonLd} ogType="article">
  <article class="lakok">
    <header class="container story">
      <p class="kicker">Dembinszky utca 18.</p>
      <h1>Lakók</h1>
      <p class="story__lead">Zongoratanárnő és színésznő, vasúti művezető és szemfedélkészítő, darukezelő és mozigépész. Fél évszázad alatt ilyen munkák kapcsolódtak a Dembinszky utca 18. lakóihoz. A foglalkozások mögött a város története is felsejlik: a századelő színházai és műhelyei, a háború utáni vasút és autóvállalkozás, majd az ötvenes évek iparosítása. Ugyanaz a cím, változó megélhetések.</p>
      <EvidenceFigure
        class="story__opening"
        image={facade}
        alt="A Dembinszky utca 18. földszintje és első emelete ferde rálátásból: arcos zárókövű, dúsan faragott ablakkeretek, kovácsoltvas erkély, a kapu előtt fiatal utcafák"
        caption={facadeCaption}
        credit={facadeCredit}
        source={facadeSource}
        widths={[400, 600, 784]}
        sizes="(min-width: 760px) 704px, 100vw"
        crop={{ aspectRatio: 4 / 3, position: 'bottom' }}
        eager
        quality={40}
      />
      <p>A névsorok az 1902–1903-as, 1903–1904-es és 1922–1923-as <em>Budapesti Czim- és Lakásjegyzék</em>, valamint az 1954-es választói névjegyzék lapképeken ellenőrzött bejegyzéseiből készültek. Az adott forrás házhoz tartozó teljes listáját közöljük; ezek eltérő célú nyilvántartások, ezért nem fedik le a ház valamennyi lakóját. A portrékhoz korabeli újságokat és hirdetéseket, hangversenyműsorokat, szakfolyóiratokat, történeti feldolgozásokat és visszaemlékezéseket is használtunk. Ahol a személyazonosság bizonytalan, azt külön jelezzük. A bizonytalan foglalkozásmegjelölések eredeti alakjukban, kérdőjellel szerepelnek; a források a cikk végén érhetők el. <sup>[<a href="#forras-1">1</a>–<a href="#forras-4">4</a>]</sup></p>
    </header>

    <section class="lakok-band lakok-band--1" aria-labelledby="kezdetek">
      <div class="container story">
        <h2 id="kezdetek">A kezdetek: színpad, műhely, hivatal, 1902–1904</h2>
        <p>A korai lakók között udvari egyenruhakészítő és szabósegéd, bankhivatalnok és bolti szolga egyaránt akadt. A szakmákon belüli különbségek is látszanak: Spitzer Adolf mészárosmester, Blau Salamon cipészsegéd volt. A házhoz művészi munka is kapcsolódott: Armandola Aranka zongorát tanított, Almássy Iza színésznőként dolgozott. A címtár néhány sora így a megélhetés különböző szintjeit és a város kulturális életét is egymás mellé helyezi. <sup>[<a href="#forras-1">1</a>–<a href="#forras-2">2</a>]</sup></p>
