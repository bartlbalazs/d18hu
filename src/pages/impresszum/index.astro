---
import Base from '../../layouts/Base.astro';
import { isMissingValue } from '../../lib/editorial/audit.ts';
import { breadcrumbNode, publisherNode, websiteNode } from '../../lib/seo/jsonld.ts';
import { loadSiteData } from '../../lib/site-data.ts';

const { site, analytics } = loadSiteData();
const siteUrl = Astro.site!;
const { impresszum } = site;
const rows = [
  { label: 'Üzemeltető', value: impresszum.operator },
  { label: 'Szerző', value: impresszum.author },
  { label: 'Kapcsolat', value: impresszum.contactEmail, isEmail: true },
  { label: 'Tárhelyszolgáltató', value: impresszum.hostingProvider, isHosting: true },
  { label: 'Szerzői jog', value: impresszum.copyrightNotice },
];
const complete = [...rows.map((row) => row.value), impresszum.hostingAddress, impresszum.hostingContactUrl].every(
  (value) => !isMissingValue(value),
);
const jsonLd = [
  websiteNode(siteUrl, site),
  breadcrumbNode(siteUrl, [
    { name: site.building.name, path: '/' },
    { name: 'Impresszum', path: '/impresszum/' },
  ]),
  ...(complete ? [publisherNode(siteUrl, impresszum)] : []),
];
---

<Base
  title="Impresszum – Dembinszky utca 18."
  description="A Dembinszky utca 18. helytörténeti oldal üzemeltetői, szerzői és kapcsolati adatai, valamint a képek és források felhasználási feltételei."
  path="/impresszum/"
  jsonLd={jsonLd}
>
  <div class="container page">
    <p class="kicker">Dembinszky utca 18.</p>
    <h1>Impresszum</h1>
    {
      complete ? (
        <dl>
          {rows.map((row) => (
            <>
              <dt>{row.label}</dt>
              {row.isEmail ? (
                <dd>
                  <a href={`mailto:${row.value}`}>{row.value}</a>
                </dd>
              ) : row.isHosting ? (
                <dd>
                  {row.value}
                  <br />
                  {impresszum.hostingAddress}
                  <br />
                  Kapcsolat:{' '}
                  <a href={impresszum.hostingContactUrl} rel="noopener noreferrer">
                    {impresszum.hostingContactUrl.replace(/^https:\/\//, '')}
                  </a>
                </dd>
              ) : (
                <dd>{row.value}</dd>
              )}
            </>
          ))}
        </dl>
      ) : (
        <p class="notice">Az impresszum adatai feltöltés alatt állnak.</p>
      )
    }
    {
      complete && (
        <p>
          Ha hibát talál, vagy emléke, fényképe, dokumentuma van a házról és lakóiról, kérjük, írjon a{' '}
          <a href={`mailto:${impresszum.contactEmail}`}>{impresszum.contactEmail}</a> címre.
        </p>
      )
    }
    <p>
      A történeti képek forrását és alkotóját az egyes képek alatt tüntetjük fel. A képek felhasználási feltételeit az
      adott archívum adatlapja tartalmazza.
    </p>
    {
      analytics.enabled && (
        <section aria-labelledby="adatkezeles">
          <h2 id="adatkezeles">Adatkezelés</h2>
          <p>
            Ha hozzájárul, a látogatásokat a Google Analytics segítségével számoljuk, hogy lássuk, hányan és mely
            oldalakat olvassák. Hozzájárulás nélkül semmilyen adat nem jut el a Google-hoz, és nem kerül süti a
            böngészőjébe. Hozzájárulás esetén azt is megjegyezzük a böngészőjében, hogyan állította be az idővonal
            csúszkáját.
          </p>
          <dl>
            <dt>Adatkezelő</dt>
            <dd>{impresszum.operator}</dd>
            <dt>Adatfeldolgozó</dt>
            <dd>
              Google Ireland Ltd. Az adatok a Google LLC-hez (USA) is eljuthatnak, az EU–USA adatvédelmi keretrendszer
              alapján.
            </dd>
            <dt>Mit mérünk</dt>
            <dd>
              A megnézett oldalakat, az eszköz típusát, a hozzávetőleges helyet és azt, honnan érkezett. Ezen felül
              három eseményt: ha megnyit egy forrás hivatkozást, ha kinagyít egy képet, és ha a menüben korszakot
              választ. IP-címet a Google Analytics nem tárol, hirdetési célra az adatokat nem használjuk.
            </dd>
            <dt>Jogalap</dt>
            <dd>Az Ön hozzájárulása (GDPR 6. cikk (1) bekezdés a) pont).</dd>
            <dt>Sütik</dt>
            <dd>A _ga és _ga_… sütik legfeljebb 13 hónapig maradnak meg.</dd>
            <dt>Idővonal-beállítás</dt>
            <dd>
              Hozzájárulás esetén a böngészője megjegyzi, melyik fokozatot választotta az idővonal csúszkáján
              (d18-idovonal). Ez nem jut el hozzánk vagy a Google-hoz, és a hozzájárulás visszavonásakor töröljük.
            </dd>
            <dt>Visszavonás</dt>
            <dd>
              A hozzájárulását bármikor visszavonhatja vagy megadhatja, bármelyik oldal alján.{' '}
              <button type="button" class="footer-link" data-consent-settings hidden>
                Statisztika beállításai
              </button>{' '}
              A döntését csak az Ön böngészője tárolja.
            </dd>
          </dl>
        </section>
      )
    }
  </div>
</Base>
