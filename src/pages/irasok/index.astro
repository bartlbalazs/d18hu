---
import Base from '../../layouts/Base.astro';
import { breadcrumbNode, websiteNode } from '../../lib/seo/jsonld.ts';
import { loadSiteData } from '../../lib/site-data.ts';

const { site } = loadSiteData();
const siteUrl = Astro.site!;
const articles = [...site.articles].sort((a, b) => b.date.localeCompare(a.date));
const jsonLd = [
  websiteNode(siteUrl, site.building.name),
  breadcrumbNode(siteUrl, [
    { name: site.building.name, path: '/' },
    { name: 'Írások', path: '/irasok/' },
  ]),
];
---

<Base
  title="Írások – Dembinszky utca 18."
  description="Hosszabb írások a Dembinszky utca 18. történetéről, lakóiról és a ház körül változó erzsébetvárosi környékről."
  path="/irasok/"
  jsonLd={jsonLd}
>
  <div class="container page">
    <p class="kicker">Dembinszky utca 18.</p>
    <h1>Írások</h1>
    {
      articles.length === 0 ? (
        <p class="notice">
          Még nem jelent meg írás. Addig az <a href="/">idővonal</a> mutatja be a ház történetét.
        </p>
      ) : (
        <ul class="article-list">
          {articles.map((article) => (
            <li>
              <h2>
                <a href={`/irasok/${article.slug}/`}>{article.title}</a>
              </h2>
              <p class="kicker">
                <time datetime={article.date}>{article.date.replaceAll('-', '. ')}.</time>
              </p>
              <p>{article.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>
