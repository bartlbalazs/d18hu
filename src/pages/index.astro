---
import { getImage } from 'astro:assets';
import facade from '../../assets/facade4.png';
import EraOpener from '../components/EraOpener.astro';
import Hero from '../components/Hero.astro';
import Legend from '../components/Legend.astro';
import MusicEntry from '../components/MusicEntry.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import ScopeSlider from '../components/ScopeSlider.astro';
import TimelineClosing from '../components/TimelineClosing.astro';
import TimelineEvent from '../components/TimelineEvent.astro';
import Base from '../layouts/Base.astro';
import { archiveImageMetadata, fullSizeImage } from '../lib/images/archive-images.ts';
import { musicImageMetadata } from '../lib/images/music-images.ts';
import { breadcrumbNode, buildingNode, imageNode, websiteNode } from '../lib/seo/jsonld.ts';
import { loadSiteData } from '../lib/site-data.ts';
import { SCOPES, scopeCounts } from '../lib/timeline/scope.ts';

const { eras, events, music, site } = loadSiteData();
const siteUrl = Astro.site!;
const title = 'Dembinszky utca 18. – egy ház története, 1873–1968';
const description =
  'Egy erzsébetvárosi bérház, lakói és a körülötte változó Budapest 1873-tól 1968-ig: 108 esemény forrásokkal és archív fényképekkel.';

const facadeImage = await getImage({ src: facade, width: 784, format: 'jpg' });
const imageNodes = await Promise.all(
  events
    .filter((event) => event.image)
    .map(async (event) => {
      const full = await fullSizeImage(archiveImageMetadata(event.image!.file));
      return imageNode(siteUrl, {
        contentUrl: full.src,
        caption: event.image!.caption,
        credit: event.image!.credit,
        sourceUrl: event.image!.sourceUrl,
        path: `/#${event.id}`,
      });
    }),
);
const musicImageNodes = await Promise.all(
  music
    .filter((entry) => entry.media)
    .map(async (entry) => {
      const media = entry.media!;
      const full = await fullSizeImage(musicImageMetadata(media.file));
      return imageNode(siteUrl, {
        contentUrl: full.src,
        caption: media.caption || media.alt,
        credit: media.credit,
        license: media.licenseUrl ?? media.license,
        sourceUrl: media.sourceUrl,
        path: `/#${entry.anchor}`,
      });
    }),
);
const jsonLd = [
  websiteNode(siteUrl, site),
  breadcrumbNode(siteUrl, [{ name: site.building.name, path: '/' }]),
  buildingNode(siteUrl, site.building, new URL(facadeImage.src, siteUrl).href, events),
  ...imageNodes,
  ...musicImageNodes,
];
---

<Base title={title} description={description} path="/" jsonLd={jsonLd}>
  <Hero hero={site.hero} />
  <Legend />
  <ScopeSlider />
  {
    eras.map((era, index) => (
      <>
        <EraOpener era={era} total={eras.length} />
        <section class="container era-events" id={`esemenyek-${era.id}`} aria-labelledby={`esemenyek-cim-${era.id}`}>
          <p class="kicker">
            Kronológia ·{' '}
            {SCOPES.map((scope) => (
              <span data-scope-count={scope}>{scopeCounts(era.events)[scope]}</span>
            ))}{' '}
            esemény
          </p>
          <h3 id={`esemenyek-cim-${era.id}`}>{era.eventsHeading}</h3>
          <ol class:list={['timeline', index === eras.length - 1 && 'timeline--ends']}>
            {era.items.map((item) =>
              'kind' in item ? <MusicEntry entry={item} /> : <TimelineEvent event={item} />,
            )}
          </ol>
        </section>
      </>
    ))
  }
  <TimelineClosing />
  <MusicPlayer />
</Base>

<script>
  import '../scripts/lightbox.ts';
  import '../scripts/print-details.ts';
</script>
