{
  "ci": {
    "collect": {
      "url": [
        "https://www.dembinszky18.hu/",
        "https://www.dembinszky18.hu/epitok/",
        "https://www.dembinszky18.hu/nevado/",
        "https://www.dembinszky18.hu/impresszum/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "optimistic"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 100
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 512000
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
